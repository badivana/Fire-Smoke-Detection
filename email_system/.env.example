# Copy to .env and edit. Never commit .env.
# cp .env.example .env

# --- App ---
APP_ENV=dev                 # dev | test | prod
DEMO_MODE=true              # true = sample emails + simulated sending, no Gmail needed
LOG_LEVEL=INFO
LOG_JSON=false
# Required when APP_ENV=prod (>= 32 chars). Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# --- Database (SQLite now; PostgreSQL later: postgresql+psycopg://user:pass@host/db) ---
# DATABASE_URL=sqlite:///./data/app.db

# --- LLM ---
LLM_PROVIDER=ollama         # ollama | openai_compatible
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
LLM_THINK=false             # keep false: qwen3 reasoning text breaks strict JSON
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=1           # 1 retry with stricter prompt, then ERROR

# OpenAI-compatible (e.g. NVIDIA NIM) — only if LLM_PROVIDER=openai_compatible
# OPENAI_COMPAT_BASE_URL=https://integrate.api.nvidia.com/v1
# OPENAI_COMPAT_MODEL=
# OPENAI_COMPAT_API_KEY=

# --- Classification ---
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.6
# CATEGORIES_FILE=./config/categories.yaml

# --- Limits ---
MAX_EMAIL_CHARS=12000
MAX_ATTACHMENT_CHARS=20000
MAX_ATTACHMENT_BYTES=15728640

# --- Attachments / OCR ---
# ATTACHMENTS_DIR=./data/attachments
OCR_ENABLED=true
# TESSERACT_CMD=/opt/homebrew/bin/tesseract

# --- Replies (used in AI drafts) ---
INSTITUTION_NAME="Greenfield Institute of Technology"
REPLY_SIGNATURE="IT/Admin Office"

# --- Sending ---
SEND_MODE=simulated         # disabled | simulated | gmail  (gmail not allowed with DEMO_MODE=true)
MAX_PROCESSING_ATTEMPTS=3
# OUTBOX_DIR=./data/outbox     # where SEND_MODE=simulated writes .eml files

# --- Gmail (Phase 11) ---
# GMAIL_CREDENTIALS_FILE=./secrets/credentials.json
# GMAIL_TOKEN_FILE=./secrets/token.json
# GMAIL_QUERY=in:inbox -in:spam newer_than:7d
